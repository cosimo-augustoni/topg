@* C-6 ConfirmDialog (ui-concept.md). Open it with IDialogService.ShowConfirmAsync. *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2">@Message</MudText>
        @if (RequiredText is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-3">Type <b>@RequiredText</b> to confirm.</MudText>
            <MudTextField T="string" @bind-Value="_typed" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          AutoFocus="true" OnKeyDown="OnKeyDown" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(Destructive ? Color.Error : Color.Primary)" Disabled="!CanConfirm"
                   OnClick="Confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _typed = "";

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public bool Destructive { get; set; }

    /// <summary>If set, the user must type this text (e.g. the project name) before confirming.</summary>
    [Parameter]
    public string? RequiredText { get; set; }

    private bool CanConfirm => RequiredText is null || _typed.Trim() == RequiredText.Trim();

    private void Confirm()
    {
        if (CanConfirm)
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Confirm();
        }
    }
}
