@using topg.Web.Quiz.Execution
<div style="position: absolute; top: 0; left: 0; background-color: var(--mud-palette-default); color: var(--mud-palette-default-text); padding: 8px 16px; font-weight: bold; z-index: 10; font-size: 1.8rem">
    @Question.Category
</div>

<div class="points-banner" style="position: absolute; top: 0; right: 0; display: flex; align-items: center; gap: 10px; background-color: var(--mud-palette-@PaletteColor); color: var(--mud-palette-@(PaletteColor)-text); padding: 8px 16px; font-weight: bold; z-index: 10; font-size: 1.8rem">
    @Points
    @if (HasBonus)
    {
        <span class="bonus-badge" style="font-size: 1rem; line-height: 1; padding: 4px 6px; border-radius: 4px; background-color: var(--mud-palette-warning-darken);">×1.5</span>
    }
</div>

@code {

    [Parameter]
    public required Question Question { get; set; }

    [Parameter]
    public required int Points { get; set; }

    [Parameter]
    public bool HasBonus { get; set; }

    private string PaletteColor => HasBonus ? "warning" : "primary";
}
