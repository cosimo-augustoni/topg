@using topg.Web.Quiz.Execution

@if (QuizSession.Quiz.CurrentQuestion != null)
{
    <MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; position: relative;" Elevation="4">

        <QuestionContextBanners Question="QuizSession.Quiz.CurrentQuestion"></QuestionContextBanners>

        <div style="flex: 1; min-height: 0; display: flex; flex-direction: column; padding-top: 3rem">
            @switch (QuizSession.Quiz.CurrentQuestion)
            {
                case ImageQuestion imageQuestion:
                    <SimpleImageQuestion QuizSession="QuizSession" ImageQuestion="imageQuestion"></SimpleImageQuestion>
                    break;
                case SoundQuestion soundQuestion:
                    break;
                case TextQuestion textQuestion:
                    <SimpleTextQuestion QuizSession="QuizSession" TextQuestion="textQuestion"></SimpleTextQuestion>
                    break;
            }
        </div>
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="MarkAsAnswered">Weiter</MudButton>
        </MudStack>

    </MudPaper>
}




@code {

    [Parameter]
    public required QuizSession QuizSession { get; set; }

    
    private void MarkAsAnswered()
    {
        QuizSession.MarkCurrentQuestionAsAnswered();
    }
}