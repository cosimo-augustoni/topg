@using topg.Web.Components.Shared
@using topg.Web.Quiz.Execution
<MudSimpleTable Dense="true" Style="height: 90%" FixedHeader="true">
    <thead>
        <tr>
            <th><MudText>Name</MudText></th>
            <th><MudText>Content</MudText></th>
            <th><MudText>Visibility</MudText></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <TextColumn>Question Text</TextColumn>
            <TextColumn>@ImageQuestion.QuestionText</TextColumn>
            <VisibilityButtonColumn Toggled="@(ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Text))" ToggledChanged="ToggleQuestionVisibility"></VisibilityButtonColumn>
        </tr>
        <tr>
            <TextColumn>Question Image</TextColumn>
            <ImageColumn ImageUrl="@ImageQuestion.QuestionImageUri.ToString()"></ImageColumn>
            <VisibilityButtonColumn Toggled="@(ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Image))" ToggledChanged="ToggleImageVisibility"></VisibilityButtonColumn>
        </tr>
        <tr style="background-color: var(--mud-palette-primary)">
            <TextColumn>Answer</TextColumn>
            <TextColumn></TextColumn>
            <TextColumn></TextColumn>
        </tr>
        <tr>
            <TextColumn>Answer Image</TextColumn>
            <ImageColumn ImageUrl="@ImageQuestion.AnswerImageUri.ToString()"></ImageColumn>
            <VisibilityButtonColumn Toggled="@(ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Answer))" ToggledChanged="ToggleAnswerVisibility"></VisibilityButtonColumn>
        </tr>
        <tr>
            <TextColumn>Answer</TextColumn>
            <TextColumn>@ImageQuestion.AnswerText</TextColumn>
            <TextColumn></TextColumn>
        </tr>
    </tbody>
</MudSimpleTable>

@code {

    [Parameter]
    public required QuizSession QuizSession { get; set; }

    [Parameter]
    public required ImageQuestion ImageQuestion { get; set; }

    private void ToggleImageVisibility()
    {
        QuizSession.UpdateQuestion(ImageQuestion, question => question.DisplayState ^= ImageQuestionDisplayState.Image);
    }

    private void ToggleQuestionVisibility()
    {
        QuizSession.UpdateQuestion(ImageQuestion, question => question.DisplayState ^= ImageQuestionDisplayState.Text);
    }

    private void ToggleAnswerVisibility()
    {
        QuizSession.UpdateQuestion(ImageQuestion, question => question.DisplayState ^= ImageQuestionDisplayState.Answer);
    }

}