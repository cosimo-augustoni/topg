@using topg.Web.Quiz.Execution
@using topg.Web.Components.Shared
<div class="qc-flex-grid">
    <div class="qc-grid-item">
        <QuestionCard Title="Question Text"
                      Toggled="@(ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Text))"
                      ToggledChanged="ToggleQuestionVisibility">
            <ChildContent>
                <MudText Typo="Typo.h4">@ImageQuestion.QuestionText</MudText>
            </ChildContent>
        </QuestionCard>
    </div>

    <div class="qc-grid-item">
        <QuestionCard Title="Question Image"
                      ImageUrl="@ImageQuestion.QuestionImageUri.ToString()"
                      Toggled="@(ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Image))"
                      ToggledChanged="ToggleImageVisibility">
        </QuestionCard>
    </div>

    <div class="qc-grid-item">
        <QuestionCard Title="Answer Text">
            <ChildContent>
                <MudText Typo="Typo.h4">@ImageQuestion.AnswerText</MudText>
            </ChildContent>
        </QuestionCard>
    </div>

    <div class="qc-grid-item">
        <QuestionCard Title="Answer Image"
                      ImageUrl="@ImageQuestion.AnswerImageUri.ToString()"
                      Toggled="@(ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Answer))"
                      ToggledChanged="ToggleAnswerVisibility">
        </QuestionCard>
    </div>
</div>

@code {

    [Parameter]
    public required QuizSession QuizSession { get; set; }

    [Parameter]
    public required ImageQuestion ImageQuestion { get; set; }

    private void ToggleImageVisibility()
    {
        QuizSession.UpdateQuestion(ImageQuestion, question => question.DisplayState ^= ImageQuestionDisplayState.Image);
    }

    private void ToggleQuestionVisibility()
    {
        QuizSession.UpdateQuestion(ImageQuestion, question => question.DisplayState ^= ImageQuestionDisplayState.Text);
    }

    private void ToggleAnswerVisibility()
    {
        QuizSession.UpdateQuestion(ImageQuestion, question => question.DisplayState ^= ImageQuestionDisplayState.Answer);
    }

}