@using topg.Web.Quiz.Execution

<MudStack>
    <MudPaper>
        <MudStack Row="true">
            <MudToggleIconButton Icon="@Icons.Material.Filled.VisibilityOff"
                                 ToggledIcon="@Icons.Material.Filled.Visibility"
                                 Toggled="@(TextQuestion.DisplayState.HasFlag(TextQuestionDisplayState.Question))"
                                 Color="@Color.Error"
                                 ToggledChanged="ToggleQuestionVisibility"
                                 ToggledColor="@Color.Success">
            </MudToggleIconButton>
            <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: bold;">@TextQuestion.QuestionText</MudText>
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Align="Align.Center" Style="font-weight: bold;">@TextQuestion.CorrectAnswer</MudText>

</MudStack>

@code {

    [Parameter]
    public required QuizSession QuizSession { get; set; }

    [Parameter]
    public required TextQuestion TextQuestion { get; set; }

    private void ToggleQuestionVisibility()
    {
        QuizSession.UpdateQuestion(TextQuestion, question => question.DisplayState ^= TextQuestionDisplayState.Question);
    }

}