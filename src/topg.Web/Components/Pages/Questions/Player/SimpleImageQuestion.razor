@using topg.Web.Quiz.Execution

<MudStack Spacing="4" Style="height:100%; flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; width: 100%; padding-top: 3rem">
    <div style="--top-row-height: 4rem; height:var(--top-row-height); flex: 0 0 var(--top-row-height); min-height: 0; display:flex; align-items:center; justify-content:center; padding:0 1rem; box-sizing:border-box; overflow:hidden;">
        @if (ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Text))
        {
            <div class="_question-text" style="width:100%; text-align:center; line-height:1; height:100%; display:flex; align-items:center; justify-content:center;">
                <MudText Style="display:block; width:100%; height:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:clamp(12px, calc(var(--top-row-height) * 0.8), 48px) !important;">@ImageQuestion.QuestionText</MudText>
            </div>
        }
    </div>

    <div style="flex:1; min-height:0; display:flex; align-items:center; justify-content:center; overflow:hidden;">
        <div style="position:relative; width:100%; max-width:100%; display:flex; align-items:center; justify-content:center; height:100%; min-height:0;">
            <div style="position:relative; height:@GetInnerBoxHeight(); width:100%; max-width:100%; margin:0 auto; overflow:hidden; display:flex; align-items:center; justify-content:center;">
                @if (ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Image))
                {
                    @* No <img> while pixelated, so the sharp image never flashes up before the canvas is drawn. *@
                    @if (ImageQuestion.PixelationBlocks is not null)
                    {
                        <canvas @ref="_canvas" aria-label="Question Image" style="height:100%; max-width:100%; width:auto; object-fit:contain; display:block; image-rendering:pixelated;" class="rounded-0"></canvas>
                    }
                    else
                    {
                        <img src="@ImageQuestion.QuestionImageUri.ToString()" alt="Question Image" style="height:100%; max-width:100%; width:auto; object-fit:contain; display:block;" class="rounded-0" />
                    }
                }
                @if (ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Answer))
                {
                    <img src="@ImageQuestion.AnswerImageUri?.ToString()" alt="Answer Image" style="position:absolute; top:0; left:50%; transform:translateX(-50%); height:100%; max-width:100%; width:auto; object-fit:contain; display:block;" class="rounded-0" />
                }
            </div>
        </div>
    </div>

</MudStack>
@code {

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    [Parameter]
    public required ImageQuestion ImageQuestion { get; set; }

    private ElementReference _canvas;
    private (string? CanvasId, Uri Image, int Blocks)? _drawn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ImageQuestion.DisplayState.HasFlag(ImageQuestionDisplayState.Image) || ImageQuestion.PixelationBlocks is not { } blocks)
        {
            _drawn = null;
            return;
        }

        // Every session change re-renders this component; only redraw when the canvas or what it shows changed.
        var target = (_canvas.Id, ImageQuestion.QuestionImageUri, blocks);
        if (_drawn == target)
        {
            return;
        }

        _drawn = target;
        await JS.InvokeVoidAsync("pixelateImage", _canvas, ImageQuestion.QuestionImageUri.ToString(), blocks);
    }

    private string GetInnerBoxHeight()
    {
        // Use percentage of the parent container's height. The MudStack and intermediate wrappers
        // are set to height:100% so these percentages will be relative to the component's allocated height.
        return ImageQuestion.ImageSize switch
        {
            Client.Shared.ImageSize.Large => "100%",
            Client.Shared.ImageSize.Medium => "70%",
            Client.Shared.ImageSize.Small => "40%",
            _ => "70%",
        };
    }
}
