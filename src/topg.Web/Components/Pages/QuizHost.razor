@page "/host/{sessionKey}"
@using topg.Web.Quiz
@using topg.Web.Templating.DomainObjects
@inject SessionHandler SessionHandler
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Topg</PageTitle>

@if (QuizSession == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudStack Style="height: 100dvh; overflow: hidden; padding: 16px; gap: 16px; box-sizing: border-box;">

        @* Top row: controls (left) + board (right) — 2/3 of screen height *@
        <MudGrid Style="flex: 2; min-height: 0;" Spacing="4">

            <MudItem xs="4" Style="min-height: 0; display: flex;">
                <MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden;" Elevation="4">
                    <MudText Typo="Typo.h4">
                        @QuizSession.Quiz.Name
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @QuizSession.SessionId.Key
                    </MudText>
                    <MudTextField T="string" Value="QuizSession.Input" Immediate="true" DebounceInterval="50" ValueChanged="v => QuizSession.UpdateInput(v)" />
                </MudPaper>
            </MudItem>

            <MudItem xs="8" Style="min-height: 0; display: flex;">
                @if (QuizSession.Quiz.CurrentQuestion == null)
                {
                    <Board QuizSession="QuizSession" IsReadOnly="false"></Board>
                }
                else
                {
                    <QuestionHost QuizSession="QuizSession"></QuestionHost>
                }
            </MudItem>

        </MudGrid>

        @* Bottom row: players — 1/3 of screen height *@
        <MudPaper Style="flex: 1; min-height: 0; width: 100%; padding: 8px; overflow: hidden; box-sizing: border-box; display: flex; align-items: center;" Elevation="4">
            <MudStack Row="true" Style="height: 100%; width: 100%; justify-content: space-evenly; align-items: center;">
                @foreach (var player in QuizSession.Players)
                {
                    <MudPaper Elevation="2" Style="aspect-ratio: 1 / 1; height: calc(100% - 16px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px; box-sizing: border-box;">
                        @if (@QuizSession.Quiz.CurrentQuestion != null)
                        {
                            <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                                <MudButton OnClick="() => AdjustPlayerScore(player, -(QuizSession.Quiz.CurrentQuestion.Template.Points / 2))">- @(QuizSession.Quiz.CurrentQuestion.Template.Points / 2)</MudButton>
                                <MudButton OnClick="() => AdjustPlayerScore(player, QuizSession.Quiz.CurrentQuestion.Template.Points)">+ @QuizSession.Quiz.CurrentQuestion.Template.Points</MudButton>
                            </MudButtonGroup>
                        }
                        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">@player.Name</MudText>
                        <MudText Typo="Typo.h3" Align="Align.Center">@player.Score</MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
}

@code {

    [Parameter]
    public string? SessionKey { get; set; }

    public QuizSession? QuizSession;

    protected override Task OnInitializedAsync()
    {
        var sessionId = SessionKey != null ? new SessionId(SessionKey) : null;
        if (sessionId != null && SessionHandler.Sessions.TryGetValue(sessionId, out var session))
        {
            QuizSession = session;
            QuizSession.SessionStateChanged += OnSessionStateChangedAsync;
        }
        else
        {
            NavigationManager.NavigateTo("/host");
        }

        return base.OnInitializedAsync();
    }

    private async Task OnSessionStateChangedAsync(object sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        if (QuizSession != null)
        {
            QuizSession.SessionStateChanged -= OnSessionStateChangedAsync;
        }
        return ValueTask.CompletedTask;
    }

    private void AdjustPlayerScore(Player player, int points)
    {
        QuizSession?.AdjustPlayerScore(player, points);
    }

}