@page "/host/{sessionKey}"
@using topg.Web.Components.Pages.Questions.Host
@using topg.Web.Quiz.Execution
@using topg.Web.Quiz.Management
@inject SessionHandler SessionHandler
@inject NavigationManager NavigationManager
@inherits QuizSessionBase

<PageTitle>Topg</PageTitle>

@if (Session == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <div style="height: 100dvh; overflow: hidden; padding: 16px; gap: 16px; box-sizing: border-box; display: flex; flex-direction: column;">

        @* Top row: controls (left) + board/question (right) — 2/3 of screen height *@
        <div style="flex: 2; min-height: 0; display: flex; flex-direction: row; gap: 16px;">

            <div style="flex: 0 0 33.333%; min-height: 0; display: flex;">
                <MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden;" Elevation="4">
                    <MudStack Spacing="5">

                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h5">@Session.Quiz.Name</MudText>
                            <SettingsButton @bind-Volume="Volume" OnClosed="SaveVolumeAsync" />
                        </MudStack>
                        <MudPaper Class="pa-2 mb-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudLink Href="@JoinLink" Target="_blank" Typo="Typo.body2" Style="word-break: break-all;">@JoinLink</MudLink>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Size="Size.Small"
                                               Title="Copy join link"
                                               OnClick="CopyJoinLinkAsync" />
                            </MudStack>
                        </MudPaper>

                        <MudPaper Style="position: relative; padding: 0.5em">
                            <MudStack>
                                <MudText Typo="Typo.h5" Align="Align.Start">Buzzer</MudText>
                                <MudText Typo="Typo.body1" Align="Align.Start">Buzzer State: @(Session.BuzzerState.IsLocked ? "Locked" : "Unlocked")</MudText>
                                <MudText Typo="Typo.body1" Align="Align.Start">Buzzered Player: @(Session.BuzzerState.BuzzeredPlayer?.Name)</MudText>
                                <MudButtonGroup DropShadow="false" Color="Color.Primary" Variant="Variant.Filled">
                                    <MudButton Disabled="@Session.BuzzerState.IsLocked" OnClick="() => Session.LockBuzzer()">Lock</MudButton>
                                    <MudButton Disabled="@(!Session.BuzzerState.IsLocked)" OnClick="() => Session.UnlockBuzzer()">Unlock</MudButton>
                                </MudButtonGroup>
                            </MudStack>

                            <MudToggleIconButton Icon="@Icons.Material.Filled.VisibilityOff"
                                                 ToggledIcon="@Icons.Material.Filled.Visibility"
                                                 Toggled="@(Session.ControlDisplayState.HasFlag(ControlDisplayState.Buzzer))"
                                                 Color="@Color.Error"
                                                 ToggledChanged="ToggleBuzzerVisibility"
                                                 Style="position: absolute; top: 5px; right: 5px"
                                                 ToggledColor="@Color.Success">
                            </MudToggleIconButton>
                        </MudPaper>

                        <MudPaper Style="position: relative; padding: 0.5em">
                            <MudStack>
                                <MudText Typo="Typo.h5" Align="Align.Start">Text</MudText>
                                <MudButtonGroup DropShadow="false" Color="Color.Primary" Variant="Variant.Filled" FullWidth="false">
                                    <MudButton Disabled="@Session.TextInputState.IsRevealed" OnClick="() => Session.RevealTextInput()">Show</MudButton>
                                    <MudButton Disabled="@(!Session.TextInputState.IsRevealed)" OnClick="() => Session.HideTextInput()">Hide</MudButton>
                                </MudButtonGroup>
                                <MudButton OnClick="() => Session.ClearTextInputs()">Clear Inputs</MudButton>
                            </MudStack>

                            <MudToggleIconButton Icon="@Icons.Material.Filled.VisibilityOff"
                                                 ToggledIcon="@Icons.Material.Filled.Visibility"
                                                 Toggled="@(Session.ControlDisplayState.HasFlag(ControlDisplayState.Text))"
                                                 Color="@Color.Error"
                                                 ToggledChanged="ToggleTextInputVisibility"
                                                 Style="position: absolute; top: 5px; right: 5px"
                                                 ToggledColor="@Color.Success">
                            </MudToggleIconButton>
                        </MudPaper>
                    </MudStack>

                </MudPaper>
            </div>

            <div style="flex: 1; min-height: 0; display: flex;">
                @if (Session.Quiz.CurrentQuestion == null)
                {
                    <Board QuizSession="Session" IsReadOnly="false"></Board>
                }
                else
                {
                    <QuestionHost QuizSession="Session"></QuestionHost>
                }
            </div>

        </div>

        @* Bottom row: players — 1/3 of screen height *@
        <MudPaper Style="flex: 1; min-height: 0; width: 100%; padding: 8px; overflow: hidden; box-sizing: border-box; display: flex; align-items: center;" Elevation="4">
            <MudStack Row="true" Style="height: 100%; width: 100%; justify-content: space-evenly; align-items: center;">
                @foreach (var player in Session.Players)
                {
                    var isBuzzered = Session.BuzzerState.BuzzeredPlayer == player;
                    var buzzerStyle = isBuzzered
                        ? "outline: 3px solid #4caf50; box-shadow: 0 0 12px 4px #4caf50;"
                        : "";
                    <MudPaper Elevation="2" Style="@($"aspect-ratio: 1 / 1; height: calc(100% - 16px); display: flex; flex-direction: column; align-items: center; position: relative; justify-content: center; padding: 8px; box-sizing: border-box; transition: box-shadow 0.2s, outline 0.2s; {buzzerStyle}")">
                        <div style="width: 95%; position: absolute; top: 10px; overflow: hidden; flex-shrink: 0; display: flex; align-items: flex-start;">
                            <MudText Align="Align.Center" Style="width: 100%; word-wrap: break-word; overflow-wrap: break-word; white-space: normal;">@Session.TextInputState.GetTextByPlayer(player)</MudText>
                        </div>
                        @if (@Session.Quiz.CurrentQuestion != null)
                        {
                            <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                                <MudButton OnClick="() => AdjustPlayerScore(player, -(Session.Quiz.CurrentQuestion.Points / 2))">- @(Session.Quiz.CurrentQuestion.Points / 2)</MudButton>
                                <MudButton OnClick="() => AdjustPlayerScore(player, Session.Quiz.CurrentQuestion.Points)">+ @Session.Quiz.CurrentQuestion.Points</MudButton>
                            </MudButtonGroup>
                        }
                        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">@player.Name</MudText>
                        <MudText Typo="Typo.h3" Align="Align.Center">@player.Score</MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    </div>

@code {

    [Parameter]
    public string? SessionKey { get; set; }

    private string JoinLink => $"{NavigationManager.BaseUri}play/{Session?.SessionId.Key}";

    private async Task CopyJoinLinkAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", JoinLink);
    }
    protected override Task OnInitializedAsync()
    {
        var sessionId = SessionKey != null ? new SessionId(SessionKey) : null;
        if (sessionId != null && SessionHandler.Sessions.TryGetValue(sessionId, out var session))
        {
            SubscribeToSession(session);
        }
        else
        {
            NavigationManager.NavigateTo("/host");
        }

        return base.OnInitializedAsync();
    }

    private void AdjustPlayerScore(Player player, int points)
    {
        Session?.AdjustPlayerScore(player, points);
    }

    private void ToggleBuzzerVisibility()
    {
        Session?.ControlDisplayState ^= ControlDisplayState.Buzzer;
    }
    private void ToggleTextInputVisibility()
    {
        Session?.ControlDisplayState ^= ControlDisplayState.Text;
    }
}
}