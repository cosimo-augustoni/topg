@page "/host/{sessionKey}"
@using topg.Web.Quiz
@using topg.Web.Templating.DomainObjects
@inject SessionHandler SessionHandler
@inject NavigationManager NavigationManager

<PageTitle>Topg</PageTitle>

@if (QuizSession == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudStack Style="height: 100dvh; overflow: hidden; padding: 16px; gap: 16px; box-sizing: border-box;">

        @* Top row: controls (left) + board (right) — 2/3 of screen height *@
        <MudGrid Style="flex: 2; min-height: 0;" Spacing="4">

            <MudItem xs="4" Style="min-height: 0; display: flex;">
                <MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden;" Elevation="4">
                    <MudText Typo="Typo.h4">
                        @QuizSession.Quiz.Name
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="8" Style="min-height: 0; display: flex;">
                <MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden;" Elevation="4">

                    @* Category header row *@
                    <MudGrid Spacing="3" Style="flex-shrink: 0; margin-bottom: 20px;">
                        @foreach (var col in Columns)
                        {
                            <MudItem Style="width: 20%; max-width: 20%; flex-basis: 20%; box-sizing: border-box;">
                                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">
                                    @col.Category
                                </MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    @* One MudGrid row per question row, each grows equally *@
                    <MudStack Spacing="2" Style="flex: 1; min-height: 0;">
                        @for (int row = 0; row < Columns.Max(c => c.Questions.Count); row++)
                        {
                            int rowCapture = row;
                            <MudGrid Spacing="5" Style="flex: 1; min-height: 0; align-items: stretch;">
                                @foreach (var col in Columns)
                                {
                                    var question = col.Questions.ElementAtOrDefault(rowCapture);
                                    <MudItem Style="width: 20%; max-width: 20%; flex-basis: 20%; box-sizing: border-box; display: flex;">
                                        @if (question != null)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                       OnClick="() => Callback(question)"
                                                       FullWidth="true"
                                                       Style="flex: 1; min-height: 0; font-size: 1.6rem; font-weight: bold;">
                                                @question.Points
                                            </MudButton>
                                        }
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudStack>

                </MudPaper>
            </MudItem>

        </MudGrid>

        @* Bottom row: players — 1/3 of screen height *@
        <MudPaper Style="flex: 1; min-height: 0; width: 100%; padding: 16px 24px; overflow: hidden; box-sizing: border-box;" Elevation="4">
            <MudText Typo="Typo.h6">Players</MudText>
        </MudPaper>

    </MudStack>
}

@code {

    [Parameter]
    public string? SessionKey { get; set; }

    public QuizSession? QuizSession;
    public Question? CurrentQuestion;

    public List<(string Category, List<Question> Questions)> Columns { get; private set; } = [];

    protected override Task OnInitializedAsync()
    {
        var sessionId = SessionKey != null ? new SessionId(SessionKey) : null;
        if (sessionId != null && SessionHandler.Sessions.TryGetValue(sessionId, out var session))
        {
            QuizSession = session;
            Columns = QuizSession.Quiz.Boards
                .OrderBy(b => b.Order)
                .First()
                .Questions
                .GroupBy(q => q.Category)
                .Select(g => (Category: g.Key, Questions: g.OrderBy(q => q.Order).ToList()))
                .ToList();
        }
        else
        {
            NavigationManager.NavigateTo("");
        }

        return base.OnInitializedAsync();
    }

    private void Callback(Question question)
    {
        CurrentQuestion = question;
    }

}