@page "/play/{sessionKey}"
@using topg.Web.Components.Pages.Questions.Player
@using topg.Web.Quiz.Execution
@using topg.Web.Quiz.Management
@inject NavigationManager NavigationManager
@inject SessionHandler SessionHandler
@inherits QuizSessionBase

<PageTitle>Topg</PageTitle>

@if (Session == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <div style="height: 100dvh; overflow: hidden; padding: 16px; gap: 16px; box-sizing: border-box; display: flex; flex-direction: column;">

        @* Top row: controls (left) + board (right) — 2/3 of screen height *@
        <div style="flex: 2; min-height: 0; display: flex; flex-direction: row; gap: 16px;">

            <div style="flex: 0 0 33.333%; min-height: 0; display: flex;">
                <MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden;" Elevation="4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">@Session.Quiz.Name</MudText>
                        <SettingsButton @bind-Volume="Volume" OnClosed="SaveVolumeAsync" />
                    </MudStack>

                    <MudButton Variant="Variant.Filled"
                               Color="@(Session.BuzzerState.BuzzeredPlayer == Player ? Color.Success : Color.Default)"
                               Disabled="@(Session.BuzzerState.IsLocked && Session.BuzzerState.BuzzeredPlayer != Player)"
                               OnClick="BuzzerClicked"
                               Style="width: 120px; height: 120px; border-radius: 50%; min-width: unset; font-size: 1.1rem; font-weight: bold; align-self: center; margin-top: 16px;">
                        BUZZ!
                    </MudButton>
                </MudPaper>
            </div>

            <div style="flex: 1; min-height: 0; display: flex;">
                @if (Session.Quiz.CurrentQuestion == null)
                {
                    <Board QuizSession="Session" IsReadOnly="true"></Board>
                }
                else
                {
                    <Question QuizSession="Session"></Question>
                }
            </div>

        </div>

        <MudPaper Style="flex: 1; min-height: 0; width: 100%; padding: 8px; overflow: hidden; box-sizing: border-box; display: flex; align-items: center;" Elevation="4">
            <MudStack Row="true" Style="height: 100%; width: 100%; justify-content: space-evenly; align-items: center;">
                @foreach (var player in Session.Players)
                {
                    var isBuzzered = Session.BuzzerState.BuzzeredPlayer == player;
                    var buzzerStyle = isBuzzered
                        ? "outline: 3px solid #4caf50; box-shadow: 0 0 12px 4px #4caf50;"
                        : "";
                    <MudPaper Elevation="2" Style="@($"aspect-ratio: 1 / 1; height: calc(100% - 16px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px; box-sizing: border-box; transition: box-shadow 0.2s, outline 0.2s; {buzzerStyle}")">
                        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">@player.Name</MudText>
                        <MudText Typo="Typo.h3" Align="Align.Center">@player.Score</MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    </div>
}


@code {
    [Parameter]
    public string? SessionKey { get; set; }

    public Player Player = null!;

    private void BuzzerClicked()
    {
        Session?.Buzz(Player);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetSessionOrLeave();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SetSessionOrLeave()
    {
        var sessionId = SessionKey != null ? new SessionId(SessionKey) : null;
        if (sessionId != null && SessionHandler.Sessions.TryGetValue(sessionId, out var session))
        {
            try
            {
                var playerSession = await ProtectedLocalStorage.GetAsync<string>(SessionConstants.PlayerSessionStorageId);
                if (playerSession.Success && session.TryGetPlayer(playerSession.Value, out var player))
                {
                    Player = player;
                    SubscribeToSession(session);
                    StateHasChanged();
                    return;
                }
            }
            catch
            {
                // When Player Session cant be established for whatever reason. Just move to the Join Screen
            }
        }
        NavigationManager.NavigateTo($"?joinCode={SessionKey}");
    }
}
