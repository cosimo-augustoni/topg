@using topg.Web.Quiz.Execution
<MudPaper Style="flex: 1; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden;" Elevation="4">

    @if (QuizSession.Quiz.CurrentBoard.IsCompleted && QuizSession.Quiz.HasNextBoard && !IsReadOnly)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SelectNextBoard"
                   FullWidth="true">
            Next Board
        </MudButton>
    }
    else
    {
        <MudGrid Spacing="3" Style="flex-shrink: 0; margin-bottom: 20px;">
            @foreach (var categoryColumn in Columns)
            {
                <MudItem Style="width: 20%; max-width: 20%; flex-basis: 20%; box-sizing: border-box;">
                    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">
                        @categoryColumn.Category
                    </MudText>
                </MudItem>
            }
        </MudGrid>

        <MudStack Spacing="2" Style="flex: 1; min-height: 0;">
            @for (int row = 0; row < Columns.Max(c => c.Questions.Count); row++)
            {
                int rowCapture = row;
                <MudGrid Spacing="5" Style="flex: 1; min-height: 0; align-items: stretch;">
                    @foreach (var col in Columns)
                    {
                        var question = col.Questions.ElementAtOrDefault(rowCapture);
                        <MudItem Style="width: 20%; max-width: 20%; flex-basis: 20%; box-sizing: border-box; display: flex;">
                            @if (question != null)
                            {
                                var hasBonus = QuizSession.HasBonus(question);
                                var buttonStyle = $"position: relative; flex: 1; min-height: 0; font-size: 1.6rem; font-weight: bold; {(hasBonus ? BonusTileStyle : "")} {(IsReadOnly ? "pointer-events: none;" : "")}";
                                <MudButton Variant="Variant.Filled" Color="@(hasBonus ? Color.Warning : Color.Primary)"
                                           OnClick="() => SelectQuestion(question)"
                                           FullWidth="true"
                                           Disabled="question.IsAnswered"
                                           Class="@(hasBonus ? "bonus-tile" : null)"
                                           Style="@buttonStyle">
                                    @QuizSession.PointsFor(question)
                                    @if (hasBonus)
                                    {
                                        <span class="bonus-badge" style="position: absolute; top: 6px; right: 8px; font-size: 0.9rem; line-height: 1; padding: 3px 6px; border-radius: 4px; background-color: var(--mud-palette-warning-darken); color: var(--mud-palette-warning-text);">
                                            ×1.5
                                        </span>
                                    }
                                </MudButton>
                            }
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudStack>
    }

    

</MudPaper>

@code {

    private const string BonusTileStyle = "box-shadow: 0 0 0 4px var(--mud-palette-warning-lighten), 0 0 16px 4px var(--mud-palette-warning-lighten);";

    [Parameter]
    public required bool IsReadOnly { get; set; } = true;

    [Parameter]
    public required QuizSession QuizSession { get; set; }

    public List<(string Category, List<Question> Questions)> Columns => QuizSession.Quiz.CurrentBoard
        .Questions
        .GroupBy(q => q.Category)
        .Select(g => (Category: g.Key, Questions: g.OrderBy(q => q.Order).ToList()))
        .OrderBy(g => g.Category)
        .ToList() ?? [];

    private void SelectQuestion(Question question)
    {
        if (IsReadOnly)
            return;

        QuizSession.SelectQuestion(question);
    }

    private void SelectNextBoard()
    {
        if (IsReadOnly)
            return;

        QuizSession.SelectNextBoard();
    }

}