@page "/"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using topg.Web.Quiz
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage ProtectedSessionStore
@inject SessionHandler SessionHandler

<PageTitle>Topg</PageTitle>

<MudStack>
    <MudTextField T="string" Required="true" @bind-Value="JoinCode" MaxLength="4"></MudTextField>
    <MudTextField T="string" Required="true" @bind-Value="Name" MaxLength="25"></MudTextField>
    <MudButton Variant="Variant.Filled" OnClick="Join" Color="Color.Primary">Join</MudButton>
</MudStack>

@code {
    public string? JoinCode { get; set; }
    public string? Name { get; set; }

    const string NameStorageId = "playerName";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var playerName = await ProtectedSessionStore.GetAsync<string>(NameStorageId);
        if (playerName.Success)
        {
            Name = playerName.Value;
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void Join()
    {
        if (JoinCode is { Length: 4 } && !string.IsNullOrWhiteSpace(Name))
        {
            if (SessionHandler.Join(new SessionId(JoinCode), Name))
            {
                ProtectedSessionStore.SetAsync(NameStorageId, Name);
                NavigationManager.NavigateTo($"/play/{JoinCode}");
            }
        }
    }
}