@page "/"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Diagnostics.CodeAnalysis
@using topg.Web.Quiz.Management
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject SessionHandler SessionHandler
@inject ILogger<Home> Logger

<PageTitle>Topg</PageTitle>

<MudGrid Justify="Justify.Center" Style="height: 100vh; align-items: center;">
    <MudItem>
        <MudPaper Class="pa-6" Elevation="4">
            <MudStack Spacing="3">
                <MudTextField T="string" Required="true" @bind-Value="JoinCode" @bind-Value:after="() => joinCodeError = null" Error="joinCodeError != null" ErrorText="@joinCodeError" MaxLength="4" Label="Join Code" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag"></MudTextField>
                <MudTextField T="string" Required="true" @bind-Value="Name" @bind-Value:after="() => nameError = null" Error="nameError != null" ErrorText="@nameError" MaxLength="25" Label="Name" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"></MudTextField>
                <MudButton Variant="Variant.Filled" OnClick="Join" Color="Color.Primary" FullWidth="true">Join</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery]
    [Parameter]
    public string? JoinCode { get; set; }
    public string? Name { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var playerName = await ProtectedLocalStorage.GetAsync<string>(SessionConstants.PlayerNameStorageId);
                if (playerName.Success)
                {
                    Name = playerName.Value;
                    StateHasChanged();
                }
            }
            catch (Exception e)
            {
                Logger.LogInformation(e, "Couldn't read Player Name from Local Storage.");
                await ProtectedLocalStorage.DeleteAsync(SessionConstants.PlayerNameStorageId);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private const string InvalidJoinCodeMessage = "Enter the 4-digit join code.";
    private const string GameNotFoundMessage = "No game with this code was found.";
    private const string MissingNameMessage = "Enter your name.";
    private const string NameTakenMessage = "This name is already taken in this game.";

    private string? joinCodeError;
    private string? nameError;

    protected override void OnInitialized()
    {
        // Players are sent here from /play/{code} when that game doesn't exist (or they aren't part of it yet).
        if (IsValidJoinCode(JoinCode) && !SessionHandler.Sessions.ContainsKey(new SessionId(JoinCode)))
            joinCodeError = GameNotFoundMessage;
    }

    private static bool IsValidJoinCode([NotNullWhen(true)] string? joinCode) =>
        joinCode is { Length: 4 } && joinCode.All(char.IsAsciiDigit);

    private async Task Join()
    {
        joinCodeError = IsValidJoinCode(JoinCode) ? null : InvalidJoinCodeMessage;
        nameError = string.IsNullOrWhiteSpace(Name) ? MissingNameMessage : null;
        if (joinCodeError != null || nameError != null)
            return;

        var name = Name!.Trim();
        switch (SessionHandler.Join(new SessionId(JoinCode!), name, out var playerId))
        {
            case JoinResult.Joined:
                await ProtectedLocalStorage.SetAsync(SessionConstants.PlayerNameStorageId, name);
                await ProtectedLocalStorage.SetAsync(SessionConstants.PlayerSessionStorageId, playerId!);
                NavigationManager.NavigateTo($"/play/{JoinCode}");
                break;
            case JoinResult.GameNotFound:
                joinCodeError = GameNotFoundMessage;
                break;
            case JoinResult.NameTaken:
                nameError = NameTakenMessage;
                break;
        }
    }
}