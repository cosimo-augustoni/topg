@page "/"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using topg.Web.Quiz.Management
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject SessionHandler SessionHandler
@inject ILogger<Home> Logger

<PageTitle>Topg</PageTitle>

<MudStack>
    <MudTextField T="string" Required="true" @bind-Value="JoinCode" MaxLength="4"></MudTextField>
    <MudTextField T="string" Required="true" @bind-Value="Name" MaxLength="25"></MudTextField>
    <MudButton Variant="Variant.Filled" OnClick="Join" Color="Color.Primary">Join</MudButton>
</MudStack>

@code {
    [SupplyParameterFromQuery]
    [Parameter]
    public string? JoinCode { get; set; }
    public string? Name { get; set; }

    const string PlayerNameStorageId = "playerName";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var playerName = await ProtectedLocalStorage.GetAsync<string>(PlayerNameStorageId);
                if (playerName.Success)
                {
                    Name = playerName.Value;
                    StateHasChanged();
                }
            }
            catch (Exception e)
            {
                Logger.LogInformation("Couldn't read Player Name from Local Storage");
                await ProtectedLocalStorage.DeleteAsync(PlayerNameStorageId);
            }
            
        }
        
        await base.OnAfterRenderAsync(firstRender);
    }

    private void Join()
    {
        if (JoinCode is { Length: 4 } && !string.IsNullOrWhiteSpace(Name))
        {
            if (SessionHandler.Join(new SessionId(JoinCode), Name, out var playerId))
            {
                ProtectedLocalStorage.SetAsync(PlayerNameStorageId, Name);
                ProtectedLocalStorage.SetAsync(SessionHandler.PlayerSessionStorageId, playerId);
                NavigationManager.NavigateTo($"/play/{JoinCode}");
            }
        }
    }
}